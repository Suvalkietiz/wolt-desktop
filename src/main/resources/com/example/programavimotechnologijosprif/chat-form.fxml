               </VBox.margin>
               <padding>
                  <Insets right="5.0" />
               </padding>
            </HBox>
         </children>
      </VBox>
      <Button fx:id="sendMessageButton" layoutX="491.0" layoutY="361.0" mnemonicParsing="false" onAction="#sendMessage" text="Send Message" />
      <Button layoutX="14.0" layoutY="362.0" mnemonicParsing="false" onAction="#deselectMessage" prefHeight="26.0" prefWidth="117.0" text="Deselect" />
   </children>
</AnchorPane>
