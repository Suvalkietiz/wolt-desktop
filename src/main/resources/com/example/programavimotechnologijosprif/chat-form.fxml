               </padding>
            </HBox>
            <HBox prefHeight="100.0" prefWidth="200.0" spacing="30.0">
               <children>
                  <Label prefHeight="17.0" prefWidth="61.0" text="Message" />
                  <TextField fx:id="messageField" />
               </children>
               <VBox.margin>
                  <Insets />
               </VBox.margin>
               <padding>
                  <Insets right="5.0" />
