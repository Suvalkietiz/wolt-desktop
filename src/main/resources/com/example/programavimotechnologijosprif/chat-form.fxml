      <VBox layoutX="330.0" layoutY="14.0" prefHeight="107.0" prefWidth="256.0">
         <children>
            <HBox prefHeight="100.0" prefWidth="200.0" spacing="30.0">
               <children>
                  <Label prefHeight="17.0" prefWidth="46.0" text="Sender" />
