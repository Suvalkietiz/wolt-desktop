<AnchorPane prefHeight="400.0" prefWidth="600.0" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.programavimotechnologijosprif.fxControllers.ChatForm">
   <children>
      <ComboBox fx:id="userSelectBox" layoutX="14.0" layoutY="14.0" onAction="#selectUser" prefHeight="26.0" prefWidth="126.0" promptText="- Select User -" />
