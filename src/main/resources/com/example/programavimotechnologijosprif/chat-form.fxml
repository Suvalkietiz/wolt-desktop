               </VBox.margin>
               <padding>
                  <Insets right="14.0" />
               </padding>
            </HBox>
            <HBox prefHeight="100.0" prefWidth="200.0" spacing="30.0">
               <children>
                  <Label prefHeight="17.0" prefWidth="52.0" text="Order ID" />
                  <TextField fx:id="orderIdField" />
               </children>
               <VBox.margin>
                  <Insets left="5.0" top="5.0" />
               </VBox.margin>
               <padding>
                  <Insets right="14.0" />
               </padding>
            </HBox>
         </children>
      </VBox>
      <Line endX="256.0" endY="1.7928931713104248" layoutX="323.0" layoutY="166.0" startX="7.5" startY="1.79290771484375" />
